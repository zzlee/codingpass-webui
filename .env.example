# CodingPass Deployment Configuration

# Secret key used for JWT signing (recommended to set a 64+ char random string)
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret

# vLLM / AI Tutor endpoint
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_MODEL=qwen3.8-flash-nvfp4
AI_PROVIDER=vllm

# Concurrency & Resource Limits
MAX_CONCURRENT_RUNS=4
CORS_ALLOW_ORIGINS=*
